* text=auto

# Keep shell and container files Unix-compatible.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf

# Keep native Windows launchers consistent.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Preserve exact signed Microsoft channel manifest bytes (including CRLF).
VoiceSTT/assets/build_inputs/windows/visual-studio-17.14.39-channel.json -text -diff

# Test audio and model fixtures are binary.
*.wav binary
*.onnx binary
*.tflite binary
*.data binary

# Archived original assignments stay byte-identical to their source.
docs/.archiv/einheitliche_triggerarchitektur/AP-SRV-060/runs/**/2026-*_PROMPT.md -text
docs/.archiv/v2_stt_model_management/runs/**/2026-*_ORIGINALPROMPT.md -text
