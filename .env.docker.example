# Copy to a separate Compose env file or set these variables in the shell.
# The existing project .env is not changed.
VOICESTT_FASTER_WHISPER_HOST_PATH=S:/MODELS/stt/ctranslate2
VOICESTT_KROKO_HOST_PATH=S:/MODELS/stt/kroko_asr
VOICESTT_OPENWAKEWORD_HOST_PATH=S:/MODELS/stt/openwakeword
VOICESTT_MODEL=small
VOICESTT_REALTIME_MODEL=Kroko-DE-Community-64-L-Streaming-001.data
VOICESTT_ENGINE=faster_whisper
VOICESTT_REALTIME_ENGINE=kroko_onnx
VOICESTT_LANGUAGE=de
VOICESTT_PORT=8010
VOICESTT_BROWSER_PORT=8081
VOICESTT_MAX_SESSIONS=8
VOICESTT_MAX_ACTIVE_SPEAKERS=4
VOICESTT_CPU_THREADS=4
VOICESTT_MODEL_IDLE_UNLOAD=1
VOICESTT_MODEL_IDLE_TIMEOUT_SECONDS=3600
VOICESTT_MODEL_MEMORY_POLICY=1
VOICESTT_ALLOW_TWO_MEDIUM_MODELS=1
# Optional bearer token for /v1/audio/transcriptions.
VOICESTT_API_KEY=sk-das1ist2der3API4KEY5von6MARCOSUDAU7
VOICESTT_ADMIN_API_KEY=sk-das1ist2der3API4KEY5von6MARCOSUDAU7
VOICESTT_DATA_PATH=./data
VOICESTT_REQUEST_LOGGING=1
VOICESTT_REQUEST_LOG_STDOUT=1
VOICESTT_REQUEST_LOG_TRANSCRIPTS=1
VOICESTT_PERFORMANCE_LOGGING=1
VOICESTT_PERFORMANCE_LOG_STDOUT=1
VOICESTT_SAVE_AUDIO_FILES=0

